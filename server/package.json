{
  "name": "meru-lead-manager-server",
  "version": "1.0.0",
  "description": "Backend API for Meru Lead Manager CRM",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node src/seed.js",
